# Copy to .env.local and adjust. Variables must start with VITE_ to reach the browser.
# Never put secrets here: everything with a VITE_ prefix is public in the built app.

# Where the API is, in front of its /api/... paths. Leave it empty almost always:
# - Deployed (staging and production): nginx forwards /api on the same address to the backend.
# - Local development: `npm run dev` forwards /api to the backend on http://localhost:8000.
# Set it only to point the app at another server, e.g. https://staging.example.org
VITE_API_BASE_URL=

# The MoFA help line shown on the Help page as "Call" and "Send us an SMS", e.g. +233302000000.
# Leave empty to hide those two rows (until MoFA confirms the number).
VITE_HELP_LINE=
