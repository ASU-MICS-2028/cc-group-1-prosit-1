# Copy to .env.local and adjust. Variables must start with VITE_ to reach the browser.
# Never put secrets here: everything with a VITE_ prefix is public in the built app.

# Where the API lives.
# - Deployed (staging and production): leave as /api. nginx forwards /api to the backend on the same origin.
# - Local development with the backend running on your machine: http://localhost:8000
VITE_API_BASE_URL=/api
