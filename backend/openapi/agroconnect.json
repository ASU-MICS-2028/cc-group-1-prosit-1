  "components": {
    "schemas": {
      "AgeBand": {
        "enum": [
          "18-25",
          "26-35",
          "36-50",
          "over_50",
          null
        ]
      },
      "AreaUnit": {
        "enum": [
          "acres",
          "hectares"
        ]
      },
      "AuthResponse": {
        "required": [
          "token",
          "expiresAt",
          "user"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/MeResponse"
          }
        }
      },
      "ChangeArea": {
        "enum": [
          "phone",
          "farm",
          "crops",
          "other"
        ]
      },
      "ChangeRequest": {
        "required": [
          "area",
          "details"
        ],
        "type": "object",
        "properties": {
          "area": {
            "$ref": "#/components/schemas/ChangeArea"
          },
          "details": {
            "type": "string"
          }
        }
      },
      "ChangeRequestResponse": {
        "required": [
          "source",
          "reference"
        ],
        "type": "object",
        "properties": {
          "source": {
            "$ref": "#/components/schemas/DataSource"
          },
          "reference": {
            "type": "string"
          }
        }
      },
      "ContactChannel": {
        "enum": [
          "sms",
          "ussd",
          "call",
          "app"
        ]
      },
      "CooperativeResponse": {
        "required": [
          "source",
          "name",
          "community",
          "members",
          "chairName",
          "chairPhoneE164",
          "nextMeeting",
          "meetingPlace"
        ],
        "type": "object",
        "properties": {
          "source": {
            "$ref": "#/components/schemas/DataSource"
          },
          "name": {
            "type": "string"
          },
          "community": {
            "type": "string"
          },
          "members": {
            "type": "integer",
            "format": "int32"
          },
          "chairName": {
            "type": "string"
          },
          "chairPhoneE164": {
            "type": "string"
          },
          "nextMeeting": {
            "type": "string",
            "format": "date"
          },
          "meetingPlace": {
            "type": "string"
          }
        }
      },
      "Crop": {
        "enum": [
          "maize",
          "sorghum",
          "rice",
          "groundnut",
          "yam",
          "cassava"
        ]
      },
      "CropAdvice": {
        "enum": [
          "check_under_leaves",
          "pick_and_crush",
          "ask_officer_spray",
          "remove_sick_leaves",
          "add_fertiliser",
          "water_early",
          "mulch_soil",
          "improve_drainage",
          "show_officer"
        ]
      },
      "CropCheckRequest": {
        "required": [
          "crop",
          "symptoms"
        ],
        "type": "object",
        "properties": {
          "crop": {
            "$ref": "#/components/schemas/Crop"
          },
          "symptoms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CropSymptom"
            }
          }
        }
      },
      "CropCheckResponse": {
        "required": [
          "source",
          "likelyProblem",
          "urgent",
          "advice"
        ],
        "type": "object",
        "properties": {
          "source": {
            "$ref": "#/components/schemas/DataSource"
          },
          "likelyProblem": {
            "$ref": "#/components/schemas/CropProblem"
          },
          "urgent": {
            "type": "boolean"
          },
          "advice": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CropAdvice"
            }
          }
        }
      },
      "CropForecast": {
        "required": [
          "crop",
          "lowBags",
          "highBags",
          "harvestMonth"
        ],
        "type": "object",
        "properties": {
          "crop": {
            "$ref": "#/components/schemas/Crop"
          },
          "lowBags": {
            "type": "integer",
            "format": "int32"
          },
          "highBags": {
            "type": "integer",
            "format": "int32"
          },
          "harvestMonth": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "CropPrice": {
        "required": [
          "crop",
          "markets",
          "weekChangePercent",
          "last30Days"
        ],
        "type": "object",
        "properties": {
          "crop": {
            "$ref": "#/components/schemas/Crop"
          },
          "markets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MarketPrice"
            }
          },
          "weekChangePercent": {
            "type": "number",
            "format": "double"
          },
          "last30Days": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          }
        }
      },
      "CropProblem": {
        "enum": [
          "fall_armyworm",
          "leaf_spot",
          "nutrient_shortage",
          "drought_stress",
          "root_rot",
          "unclear"
        ]
      },
      "CropSymptom": {
        "enum": [
          "yellow_leaves",
          "holes_in_leaves",
          "spots_on_leaves",
          "wilting",
          "insects_seen",
          "stunted",
          "rotting"
        ]
      },
      "DataPurchase": {
        "enum": [
          "daily",
          "weekly",
          "monthly",
          "none",
          null
        ]
      },
      "DataSource": {
        "enum": [
          "sample",
          "live"
        ]
      },
      "FarmObservation": {
        "enum": [
          "all_good",
          "pests",
          "disease",
          "dry_soil",
          "flooding"
        ]
      },
      "FarmerProfile": {
        "required": [
          "id",
          "fullName",
          "phoneE164",
          "hasNoPhone",
          "gender",
          "ageBand",
          "community",
          "regionDistrict",
          "language",
          "consentAt",
          "crops",
          "farmSize",
          "farmSizeUnit",
          "soil",
          "plantingSeasons",
          "latitude",
          "longitude",
          "locationAccuracyMetres",
          "phoneType",
          "reachChannels",
          "mobileMoney",
          "helpNeeded",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "fullName": {
            "type": "string"
          },
          "phoneE164": {
            "type": [
              "null",
              "string"
            ]
          },
          "hasNoPhone": {
            "type": "boolean"
          },
          "gender": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Gender"
              }
            ]
          },
          "ageBand": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AgeBand"
              }
            ]
          },
          "community": {
            "type": [
              "null",
              "string"
            ]
          },
          "regionDistrict": {
            "type": [
              "null",
              "string"
            ]
          },
          "language": {
            "$ref": "#/components/schemas/Language"
          },
          "consentAt": {
            "type": "string",
            "format": "date-time"
          },
          "crops": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Crop"
            }
          },
          "farmSize": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "farmSizeUnit": {
            "$ref": "#/components/schemas/AreaUnit"
          },
          "soil": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SoilType"
              }
            ]
          },
          "plantingSeasons": {
