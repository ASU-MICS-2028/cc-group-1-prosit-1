            "body": {
              "mode": "raw",
              "raw": "{\n  \"purpose\": \"inputs\",\n  \"description\": \"Tolon Agro Inputs\",\n  \"amount\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "amount in GH₵ (1 to 10,000). The reference is saved for the next two requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.reference) pm.collectionVariables.set(\"reference\", body.reference);",
                  "pm.test(\"has a status\", () => pm.expect(body.status).to.be.a(\"string\"));"
                ]
              }
            }
          ]
