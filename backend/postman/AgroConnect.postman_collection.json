{
  "info": {
    "name": "AgroConnect API",
    "description": "Every AgroConnect endpoint, grouped by who uses it.\n\n1. Start the API (port 8000).\n2. Open a \"Sign in as …\" folder and run 1, then 2: the token is saved.\n3. Run any request in that person's folder.\n\nTest phones (laptop, code 123456): officer 024 000 0001, farmer 024 000 1234, MoFA admin 024 000 0009.\nSigning in again as someone else replaces the token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "reference",
      "value": ""
    },
    {
      "key": "ussdSession",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Is the API up?",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Sign in as extension officer",
      "description": "Run 1 then 2. On a laptop the code is always 123456. The token is saved for every other request.",
      "item": [
        {
          "name": "1. Ask for a code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/code",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "code"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"024 000 0001\",\n  \"role\": \"officer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "On a laptop no SMS is sent to the demo numbers: the code is in the API log and is always 123456."
          }
        },
        {
          "name": "2. Enter the code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "verify"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"024 000 0001\",\n  \"role\": \"officer\",\n  \"code\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.token) {",
                  "  pm.collectionVariables.set(\"token\", body.token);",
                  "  console.log(\"Signed in as \" + body.user.fullName + \" (\" + body.user.role + \")\");",
                  "}",
                  "pm.test(\"signed in\", () => pm.expect(body.token).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "me"
              ]
            }
          }
        }
      ]
    },
