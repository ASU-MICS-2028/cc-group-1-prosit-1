# Copy to terraform.tfvars (git-ignored) and fill in.

budget_limit_usd = 20
budget_emails    = ["you@example.com", "teammate@example.com"]

# GitHub token with read:packages only (Settings > Developer settings > Personal access
# tokens). New servers started by Auto Scaling use it to pull the app images.
ghcr_pull_user  = "your-github-user"
ghcr_pull_token = "ghp_..."

# running = false scales an environment to 0 servers. host = its domain, "" for none yet.
environments = {
  staging    = { instance_type = "t3.micro", running = false, min_size = 1, max_size = 1, host = "" }
  production = { instance_type = "t3.micro", running = false, min_size = 2, max_size = 4, host = "" }
}

# HTTPS once there is a domain and an ACM certificate for it (in af-south-1).
certificate_arn = ""

# Browser addresses allowed to upload photos to S3 (add the HTTPS domain later).
photo_upload_origins = ["http://localhost:5173"]

enable_rds   = true
rds_multi_az = false

# Only for the one-time move of the database into the private subnets (README).
# rds_restore_snapshot = "agroconnect-production-move"
